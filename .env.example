# Скопируйте в .env.local и заполните значениями dev-проекта Supabase.
# .env.local в Git не попадает — это проверено .gitignore.
#
# Ключ service_role даёт полный доступ в обход политик. Он нужен только
# скриптам на вашей машине и Edge Functions. В браузер, в репозиторий и в
# переписку он не попадает никогда.

SUPABASE_URL=https://<ref-проекта>.supabase.co
SUPABASE_ANON_KEY=<анонимный ключ>
SUPABASE_SERVICE_ROLE_KEY=<ключ service_role>
