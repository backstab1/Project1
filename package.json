{
  "name": "cinevault",
  "version": "0.11.0-beta.1",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "python launch.py",
    "test": "node --test",
    "test:python": "python -m unittest discover -s tests -p \"test_*.py\"",
    "test:all": "npm run test && npm run test:python",
    "db:push": "supabase db push",
    "db:diff": "supabase db diff",
    "check:rls": "node --env-file=.env.local scripts/check-rls.mjs",
    "vendor:supabase": "esbuild vendor/supabase-entry.js --bundle --format=esm --minify --target=es2022 --outfile=vendor/supabase.esm.js --legal-comments=none",
    "check:functions": "node --env-file=.env.local scripts/check-functions.mjs",
    "check:library": "node --env-file=.env.local scripts/check-library.mjs",
    "check:tmdb": "node --env-file=.env.local scripts/check-tmdb.mjs"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "esbuild": "^0.23.0",
    "supabase": "^2.115.0"
  },
  "allowScripts": {
    "esbuild@0.23.1": true,
    "supabase@1.226.4": true
  }
}
